{
  "name": "zipkit",
  "productName": "ZipKit",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.2.0",
  "description": "Make ZIP archives on a Mac that open cleanly on Windows: fix file names, drop Mac-only junk, and verify the result.",
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Yoshinao Inoguchi",
    "email": "yoshinao@inoguchi.com",
    "url": "https://github.com/nao7sep"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nao7sep/zipkit.git"
  },
  "type": "module",
  "workspaces": [
    "sdk"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite --entry ./out/main/index.js",
    "build:gui": "npm run typecheck:node && npm run typecheck:web && electron-vite build",
    "dist": "npm run build:gui && npm run prepare:electron && electron-builder --publish never",
    "prepare:electron": "node node_modules/electron/install.js",
    "preview": "electron-vite preview --entry ./out/main/index.js",
    "build:mac": "npm run build:gui && npm run prepare:electron && electron-builder --mac",
    "build:win": "npm run build:gui && npm run prepare:electron && electron-builder --win",
    "typecheck:node": "tsc --noEmit --composite false -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit --composite false -p tsconfig.web.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test",
    "test": "npm run typecheck && npm run typecheck -w zipkitsdk && vitest run",
    "check:release-tag": "node scripts/check-release-tag.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.0",
    "@radix-ui/react-dropdown-menu": "^2.2.0",
    "@tanstack/react-virtual": "^3.14.20",
    "defu": "^6.1.7",
    "diff": "^9.0.0",
    "nanoid": "^6.0.2",
    "p-limit": "^7.3.3",
    "picomatch": "^4.0.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stream-chain": "^4.2.6",
    "stream-json": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.4",
    "electron": "^44.7.0",
    "electron-builder": "^26.17.0",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1",
    "zipkitsdk": "0.1.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": false
  }
}
