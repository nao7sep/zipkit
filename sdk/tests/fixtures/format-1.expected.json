{
  "format": "zipkit.manifest",
  "formatVersion": 1,
  "policy": {
    "exclusions": [
      {
        "pattern": ".DS_Store",
        "match": "glob",
        "target": "both",
        "ignoreCase": true,
        "note": "Finder’s view settings for a folder, rebuilt when it is opened"
      },
      {
        "pattern": "._*",
        "match": "glob",
        "target": "both",
        "ignoreCase": true,
        "note": "Mac file details stored as separate files on drives that aren’t Mac-formatted"
      },
      {
        "pattern": "__MACOSX/",
        "match": "glob",
        "target": "dir",
        "ignoreCase": true,
        "note": "Mac file details left behind by unzipping a Mac-made ZIP"
      },
      {
        "pattern": "Icon\r",
        "match": "glob",
        "target": "both",
        "ignoreCase": true,
        "note": "A custom folder icon, whose image a ZIP can’t hold"
      },
      {
        "pattern": ".localized",
        "match": "glob",
        "target": "both",
        "ignoreCase": true,
        "note": "Finder’s marker for a folder shown under a translated name"
      },
      {
        "pattern": ".Trashes",
        "match": "glob",
        "target": "both",
        "ignoreCase": true,
        "note": "A drive’s Trash (macOS)"
      },
      {
        "pattern": ".Spotlight-V100",
        "match": "glob",
        "target": "both",
        "ignoreCase": true,
        "note": "A drive’s Spotlight search index (macOS)"
      },
      {
        "pattern": ".fseventsd",
        "match": "glob",
        "target": "both",
        "ignoreCase": true,
        "note": "A drive’s log of file changes (macOS)"
      },
      {
        "pattern": ".TemporaryItems",
        "match": "glob",
        "target": "both",
        "ignoreCase": true,
        "note": "A drive’s temporary files (macOS)"
      },
      {
        "pattern": ".DocumentRevisions-V100",
        "match": "glob",
        "target": "both",
        "ignoreCase": true,
        "note": "A drive’s database of saved document versions (macOS)"
      },
      {
        "pattern": ".MobileBackups/",
        "match": "glob",
        "target": "dir",
        "ignoreCase": true,
        "note": "A drive’s local Time Machine snapshots (older macOS)"
      },
      {
        "pattern": ".VolumeIcon.icns",
        "match": "glob",
        "target": "both",
        "ignoreCase": true,
        "note": "A drive’s custom icon (macOS)"
      },
      {
        "pattern": ".com.apple.timemachine.donotpresent",
        "match": "glob",
        "target": "both",
        "ignoreCase": true,
        "note": "Time Machine’s marker on a backup drive"
      },
      {
        "pattern": ".AppleDouble/",
        "match": "glob",
        "target": "dir",
        "ignoreCase": true,
        "note": "Mac file details kept by a file server or a drive that isn’t Mac-formatted"
      },
      {
        "pattern": ".apdisk",
        "match": "glob",
        "target": "both",
        "ignoreCase": true,
        "note": "A shared drive’s AirPort Disk settings"
      },
      {
        "pattern": ".AppleDB",
        "match": "glob",
        "target": "both",
        "ignoreCase": true,
        "note": "An old Apple file server’s own database"
      },
      {
        "pattern": ".AppleDesktop",
        "match": "glob",
        "target": "both",
        "ignoreCase": true,
        "note": "An old Apple file server’s own database"
      },
      {
        "pattern": "Desktop DB",
        "match": "glob",
        "target": "both",
        "ignoreCase": true,
        "note": "A drive’s desktop database (classic Mac OS)"
      },
      {
        "pattern": "Desktop DF",
        "match": "glob",
        "target": "both",
        "ignoreCase": true,
        "note": "A drive’s desktop database (classic Mac OS)"
      },
      {
        "pattern": "Thumbs.db",
        "match": "glob",
        "target": "both",
        "ignoreCase": true,
        "note": "Windows’ thumbnail cache"
      },
      {
        "pattern": "desktop.ini",
        "match": "glob",
        "target": "both",
        "ignoreCase": true,
        "note": "A folder’s display settings, added by Windows and sync apps"
      },
      {
        "pattern": "$RECYCLE.BIN/",
        "match": "glob",
        "target": "dir",
        "ignoreCase": true,
        "note": "A drive’s Recycle Bin (Windows)"
      },
      {
        "pattern": "RECYCLER/",
        "match": "glob",
        "target": "dir",
        "ignoreCase": true,
        "note": "A drive’s Recycle Bin (older Windows)"
      },
      {
        "pattern": "RECYCLED/",
        "match": "glob",
        "target": "dir",
        "ignoreCase": true,
        "note": "A drive’s Recycle Bin (older Windows)"
      },
      {
        "pattern": "System Volume Information/",
        "match": "glob",
        "target": "dir",
        "ignoreCase": true,
        "note": "A drive’s restore points and search index (Windows)"
      },
      {
        "pattern": "pagefile.sys",
        "match": "glob",
        "target": "both",
        "ignoreCase": true,
        "note": "A drive’s Windows memory or hibernation file"
      },
      {
        "pattern": "hiberfil.sys",
        "match": "glob",
        "target": "both",
        "ignoreCase": true,
        "note": "A drive’s Windows memory or hibernation file"
      },
      {
        "pattern": "swapfile.sys",
        "match": "glob",
        "target": "both",
        "ignoreCase": true,
        "note": "A drive’s Windows memory or hibernation file"
      },
      {
        "pattern": "ehthumbs.db",
        "match": "glob",
        "target": "both",
        "ignoreCase": true,
        "note": "Windows Media Center’s thumbnail cache"
      },
      {
        "pattern": "ehthumbs_vista.db",
        "match": "glob",
        "target": "both",
        "ignoreCase": true,
        "note": "Windows Media Center’s thumbnail cache"
      },
      {
        "pattern": ".directory",
        "match": "glob",
        "target": "both",
        "ignoreCase": true,
        "note": "A folder’s display settings in KDE (Linux)"
      },
      {
        "pattern": ".Trash-*/",
        "match": "glob",
        "target": "dir",
        "ignoreCase": true,
        "note": "A drive’s Trash (Linux)"
      },
      {
        "pattern": ".nfs*",
        "match": "glob",
        "target": "both",
        "ignoreCase": true,
        "note": "A file deleted on a network share while still open"
      },
      {
        "pattern": ".fuse_hidden*",
        "match": "glob",
        "target": "both",
        "ignoreCase": true,
        "note": "A file deleted while still open (Linux)"
      }
    ],
    "emptyFiles": "keep",
    "emptyDirs": "keep",
    "names": {
      "nfc": "fix",
      "invalidChars": "fix",
      "invalidCharReplacement": "_",
      "invalidCharStyle": "tidy",
      "controlChars": "fix",
      "trailingDotSpace": "fix",
      "reserved": "fix",
      "suspicious": "warn"
    },
    "symlinks": "ignore",
    "followExternal": false,
    "compression": {
      "stored": "builtin",
      "store": [],
      "level": 6
    },
    "manifest": {
      "name": "zipkit.json",
      "hash": true
    },
    "timeZone": "UTC"
  },
