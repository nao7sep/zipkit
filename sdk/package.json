{
  "name": "zipkitsdk",
  "version": "0.1.0",
  "private": true,
  "description": "ZipKit's SDK: make ZIP archives that open cleanly on any system, fixing file names, leaving out OS junk and verifying the result.",
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Yoshinao Inoguchi",
    "email": "yoshinao@inoguchi.com",
    "url": "https://github.com/nao7sep"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nao7sep/zipkit.git",
    "directory": "sdk"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/browser.ts",
    "./testing": "./src/testing.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.browser.json && tsc --noEmit -p tsconfig.test.json",
    "test": "npm run typecheck && vitest run"
  },
  "dependencies": {
    "defu": "^6.1.7",
    "nanoid": "^6.0.2",
    "picomatch": "^4.0.7",
    "stream-chain": "^4.2.6",
    "stream-json": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/picomatch": "^4.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
